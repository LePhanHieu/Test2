# Secret key for Flask session signing; generate using secrets.token_hex(32).
SECRET_KEY=replace_with_your_own_secret_key_here
# Default DB: <project>/instance/dermascan.db. Optional override:
# DATABASE_URL=sqlite:////absolute/path/to/instance/dermascan.db
SESSION_COOKIE_SECURE=false
# Optional paths used by the training/legacy AI scripts. Leave empty to use project-relative defaults.
# SKIN_CANCER_BASE=
# ISIC_DATA_DIR=
# Only enable for local fictional demo data. Never use real passwords here.
ALLOW_DEMO_SEED=true
DEMO_PASSWORD=123456123456
# SMTP configuration for Flask-Mail.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_DEFAULT_SENDER=DermaScan AI <noreply@example.com>
MAIL_TIMEOUT=10
# Rate limiting. Use Redis or another shared backend with multiple workers.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=5 per minute
RATELIMIT_REPORT=20 per hour
RATELIMIT_EXPENSIVE=30 per hour

# OpenAI ChatGPT Integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
