# Secret key for Flask session signing; generate using secrets.token_hex(32).
SECRET_KEY=replace_with_your_own_secret_key_here
# Default DB: <project>/instance/dermascan_live.db (separate from legacy demo data).
# Optional override (use a fresh empty SQLite file):
# DATABASE_URL=sqlite:////absolute/path/to/instance/dermascan_live.db
SESSION_COOKIE_SECURE=false
# Optional paths used by the training/legacy AI scripts. Leave empty to use project-relative defaults.
# SKIN_CANCER_BASE=
# ISIC_DATA_DIR=
# Demo provisioning is disabled. Run the interactive `setup-initial` command
# to create the first ADMIN, DOCTOR and USER on a new database instead.
ALLOW_DEMO_SEED=false
# SMTP configuration for Flask-Mail.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_DEFAULT_SENDER=DermaScan AI <noreply@example.com>
MAIL_TIMEOUT=10
# Rate limiting. Use Redis or another shared backend with multiple workers.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=5 per minute
RATELIMIT_REPORT=20 per hour
RATELIMIT_EXPENSIVE=30 per hour

# OpenAI ChatGPT Integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
